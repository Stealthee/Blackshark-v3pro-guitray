# Maintainer: Mehmet Bayoglu
pkgname=lynapse
pkgver=0.1.27
pkgrel=1
pkgdesc="Lynapse — GTK4 control panel for the Razer BlackShark V3 (openrazer razerkraken)"
arch=('any')
url="https://github.com/Stealthee/Blackshark-v3pro-guitray"
license=('GPL2')
# NOTE: stock openrazer-driver-dkms (extra/) doesn't support the V3 Pro yet —
# that needs mehmetbayoglu/openrazer branch blackshark-v3-pro until the
# upstream PR lands (see README). Depends on the package name, not the fork,
# since AUR can't express "this branch of this package".
depends=('python' 'python-gobject' 'gtk4' 'openrazer-driver-dkms')
makedepends=('python-build' 'python-pip' 'python-setuptools' 'python-wheel')
# GitHub names the tarball's top-level directory after the repo, not
# pkgname — it unpacks to "Blackshark-v3pro-guitray-$pkgver", not
# "lynapse-$pkgver", hence _srcdir below rather than the more usual
# "cd $pkgname-$pkgver".
_srcdir="Blackshark-v3pro-guitray-$pkgver"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('417f7717dc3966c30b09df2ca401180a91a0ad443db940860257f7af191cd4f7')

build() {
    cd "$_srcdir"
    python -m build --wheel --no-isolation
}

package() {
    cd "$_srcdir"
    # python -m installer resolves each destination path against the real
    # (non-staged) system site-packages to sanity-check it, which trips a
    # false positive if that path already exists there as a symlink (e.g.
    # a prior ./install.sh run's /usr/local compat-symlink scheme — see
    # README's install notes). pip's --root install doesn't do that check,
    # and is the same mechanism install.sh itself already uses.
    # --no-compile: skip .pyc generation here — bytecode caches embed the
    # absolute $pkgdir build path (fakeroot's staging dir) in co_filename,
    # which makepkg's packaging-issue check correctly flags as a leaked
    # build path. Python just compiles on first import instead.
    pip install --root="$pkgdir" --no-deps --ignore-installed --no-compile --prefix=/usr dist/*.whl
    # pip's direct_url.json records the absolute $srcdir path it installed
    # from — same class of build-path leak, and no runtime purpose once
    # packaged, so drop it.
    rm -f "$pkgdir"/usr/lib/python*/site-packages/*.dist-info/direct_url.json
    install -Dm644 data/lynapse.desktop "$pkgdir/usr/share/applications/lynapse.desktop"
    install -Dm644 data/lynapse.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/lynapse.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
